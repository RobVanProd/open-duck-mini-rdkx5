diff --git a/playground/common/t37_frozen_observation_normalizer.py b/playground/common/t37_frozen_observation_normalizer.py
new file mode 100644
index 0000000..d841654
--- /dev/null
+++ b/playground/common/t37_frozen_observation_normalizer.py
@@ -0,0 +1,37 @@
+"""Freeze restored Welford observation statistics during T37 training."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import Any
+
+from brax.training.acme import running_statistics
+
+
+def _frozen_update(
+    state: running_statistics.RunningStatisticsState,
+    batch: Any,
+    **kwargs: Any,
+) -> running_statistics.RunningStatisticsState:
+    """Return the restored statistics without changing any leaf."""
+    del batch, kwargs
+    return state
+
+
+@contextmanager
+def frozen_observation_statistics_updates() -> Iterator[None]:
+    """Temporarily make Brax running-statistic updates exact identities.
+
+    Brax's ``normalize_until_count`` only suppresses the EMA update rate in
+    the installed version. The winner uses Welford statistics, so T37 must
+    freeze ``update`` itself while leaving observation normalization enabled.
+    """
+    original = running_statistics.update
+    if original is _frozen_update:
+        raise RuntimeError("T37 observation-statistics freeze is re-entrant")
+    running_statistics.update = _frozen_update
+    try:
+        yield
+    finally:
+        running_statistics.update = original
