+    _RESET_COM_ACCEL_NEGATIVE = jp.array(
+        [-13.04679012298584, 0.7727481126785278, 28.672449111938477]
+    )
+    _RESET_COM_ACCEL_NOMINAL = jp.array(
+        [-11.879271507263184, 0.8971166610717773, 29.650177001953125]
+    )
+    _RESET_COM_ACCEL_POSITIVE = jp.array(
+        [-10.715840339660645, 1.0117170810699463, 30.856430053710938]
+    )
+
+    def _ground_up_reset_com_estimate(self, accelerometer: jax.Array) -> jax.Array:
+        """Frozen three-anchor piecewise-linear reset X-COM estimate in metres."""
+        nominal = self._RESET_COM_ACCEL_NOMINAL
+        negative_direction = self._RESET_COM_ACCEL_NEGATIVE - nominal
+        positive_direction = self._RESET_COM_ACCEL_POSITIVE - nominal
+        delta = accelerometer - nominal
+        negative_fraction = jp.clip(
+            jp.dot(delta, negative_direction)
+            / jp.dot(negative_direction, negative_direction),
+            0.0,
+            1.0,
+        )
+        positive_fraction = jp.clip(
+            jp.dot(delta, positive_direction)
+            / jp.dot(positive_direction, positive_direction),
+            0.0,
+            1.0,
+        )
+        negative_residual = jp.linalg.norm(
+            accelerometer - (nominal + negative_fraction * negative_direction)
+        )
+        positive_residual = jp.linalg.norm(
+            accelerometer - (nominal + positive_fraction * positive_direction)
+        )
+        return jp.where(
+            negative_residual <= positive_residual,
+            -0.05 * negative_fraction,
+            0.05 * positive_fraction,
+        )
+
