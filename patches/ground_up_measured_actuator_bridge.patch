+    def _apply_ground_up_measured_actuator_bridge(
+        self, info: dict[str, Any], sent_motor_targets: jax.Array
+    ) -> jax.Array:
+        """Apply the frozen fitted plant transition without adding a reward."""
+        history = (
+            jp.roll(
+                info["ground_up_actuator_bridge_target_history"], self._actuators
+            )
+            .at[: self._actuators]
+            .set(sent_motor_targets)
+        )
+        history_matrix = history.reshape((-1, self._actuators))
+        delay_ticks = jp.asarray(
+            self._config.ground_up_actuator_bridge_delay_ticks, dtype=jp.int32
+        )
+        delayed_target = history_matrix[
+            delay_ticks, jp.arange(self._actuators)
+        ]
+        previous_applied = info["ground_up_actuator_bridge_applied_targets"]
+        tau_s = jp.maximum(
+            jp.asarray(self._config.ground_up_actuator_bridge_tau_s), 1.0e-4
+        )
+        alpha = 1.0 - jp.exp(-self.dt / tau_s)
+        lagged_target = previous_applied + alpha * (
+            delayed_target - previous_applied
+        )
+        max_step = (
+            jp.asarray(self._config.ground_up_action_velocity_limits_rad_s) * self.dt
+        )
+        applied_target = jp.clip(
+            lagged_target,
+            previous_applied - max_step,
+            previous_applied + max_step,
+        )
+        info["ground_up_actuator_bridge_target_history"] = history
+        info["ground_up_actuator_bridge_applied_targets"] = applied_target
+        return applied_target
+
