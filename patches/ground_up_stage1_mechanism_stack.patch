+        )
+        max_action_error = max(
+            max_action_error, float(np.max(np.abs(expected_action - actual_action)))
+        )
+        max_hidden_error = max(
+            max_hidden_error,
+            float(np.max(np.abs(np.asarray(next_hidden) - next_hidden_onnx))),
+        )
+        hidden_jax = np.asarray(next_hidden)
+        hidden_onnx = next_hidden_onnx
+    if max(max_action_error, max_hidden_error) > 1.0e-5:
+        raise ValueError(
+            f"recurrent ONNX mismatch action={max_action_error} hidden={max_hidden_error}"
+        )
+    return {
+        "path": str(output_path),
+        "steps_checked": 8,
+        "max_action_error": max_action_error,
+        "max_hidden_error": max_hidden_error,
+    }
