@@ -0,0 +1,318 @@
+"""Stateful recurrent PPO policy, collector hook, and ONNX export."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+
+from brax.training import distribution
+from brax.training import networks as brax_networks
+from brax.training import types
+from brax.training.agents.ppo import networks as ppo_networks
+from flax import linen
+import flax
+import jax
+import jax.numpy as jnp
+import numpy as np
+
+
+HIDDEN_OBSERVATION_KEY = "policy_hidden"
+
+
+class RecurrentPolicy(linen.Module):
+    param_size: int
+    hidden_size: int
+
+    @linen.compact
+    def __call__(self, normalized_obs, hidden_in):
+        obs_projection = linen.Dense(
+            self.hidden_size, use_bias=False, name="obs_projection"
+        )(normalized_obs)
+        hidden_projection = linen.Dense(
+            self.hidden_size, use_bias=False, name="hidden_projection"
+        )(hidden_in)
+        bias = self.param("hidden_bias", jax.nn.initializers.zeros, (self.hidden_size,))
+        hidden_out = jnp.tanh(obs_projection + hidden_projection + bias)
+        logits = linen.Dense(self.param_size, name="distribution_head")(hidden_out)
+        return logits, hidden_out
+
+
+@flax.struct.dataclass
+class RecurrentPolicyNetwork:
+    init: object
+    apply: object
+    apply_with_state: object
+
+
+def make_recurrent_ppo_networks(
+    observation_size: types.ObservationSize,
+    action_size: int,
+    preprocess_observations_fn: types.PreprocessObservationFn = types.identity_observation_preprocessor,
+    policy_hidden_layer_sizes: Sequence[int] = (512, 256, 128),
+    value_hidden_layer_sizes: Sequence[int] = (512, 256, 128),
+    policy_obs_key: str = "state",
+    value_obs_key: str = "privileged_state",
+    recurrent_hidden_size: int = 64,
+    **kwargs,
+) -> ppo_networks.PPONetworks:
+    del policy_hidden_layer_sizes
+    base = ppo_networks.make_ppo_networks(
+        observation_size=observation_size,
+        action_size=action_size,
+        preprocess_observations_fn=preprocess_observations_fn,
+        policy_hidden_layer_sizes=(recurrent_hidden_size,),
+        value_hidden_layer_sizes=value_hidden_layer_sizes,
+        policy_obs_key=policy_obs_key,
+        value_obs_key=value_obs_key,
+        **kwargs,
+    )
+    action_distribution = distribution.NormalTanhDistribution(event_size=action_size)
+    module = RecurrentPolicy(action_distribution.param_size, recurrent_hidden_size)
+    state_shape = observation_size[policy_obs_key]
+    state_size = int(jax.tree_util.tree_flatten(state_shape)[0][-1])
+
+    def init(key):
+        return module.init(
+            key,
+            jnp.zeros((1, state_size)),
+            jnp.zeros((1, recurrent_hidden_size)),
+        )
+
+    def apply_with_state(processor_params, policy_params, obs):
+        if not isinstance(obs, Mapping) or HIDDEN_OBSERVATION_KEY not in obs:
+            raise ValueError("recurrent policy requires policy_hidden observation")
+        raw = obs[policy_obs_key]
+        normalized = preprocess_observations_fn(
+            raw, brax_networks.normalizer_select(processor_params, policy_obs_key)
+        )
+        return module.apply(policy_params, normalized, obs[HIDDEN_OBSERVATION_KEY])
+
+    def apply(processor_params, policy_params, obs):
+        logits, _ = apply_with_state(processor_params, policy_params, obs)
+        return logits
+
+    policy_network = RecurrentPolicyNetwork(
+        init=init, apply=apply, apply_with_state=apply_with_state
+    )
+    return ppo_networks.PPONetworks(
+        policy_network=policy_network,
+        value_network=base.value_network,
+        parametric_action_distribution=action_distribution,
+    )
+
+
+def make_recurrent_inference_fn(
+    networks: ppo_networks.PPONetworks,
+    compute_value: bool = False,
+    use_distributional_critic: bool = False,
+):
+    """Brax-compatible inference factory that also returns the next hidden state."""
+
+    def make_policy(params: types.Params, deterministic: bool = False):
+        def policy(observations: types.Observation, key_sample: types.PRNGKey):
+            logits, hidden_out = networks.policy_network.apply_with_state(
+                params[0], params[1], observations
+            )
+            action_distribution = networks.parametric_action_distribution
+            if deterministic:
+                action = action_distribution.mode(logits)
+                extras = {"policy_hidden_out": hidden_out}
+            else:
+                raw_action = action_distribution.sample_no_postprocessing(
+                    logits, key_sample
+                )
+                action = action_distribution.postprocess(raw_action)
+                extras = {
+                    "log_prob": action_distribution.log_prob(logits, raw_action),
+                    "raw_action": raw_action,
+                    "distribution_params": logits,
+                    "policy_hidden_out": hidden_out,
+                }
+            if compute_value:
+                value = networks.value_network.apply(params[0], params[2], observations)
+                if use_distributional_critic:
+                    value, quantiles = value
+                    extras["quantiles"] = quantiles
+                extras["value"] = value
+            return action, extras
+
+        return policy
+
+    return make_policy
+
+
+def recurrent_actor_step(env, env_state, policy, key, extra_fields=()):
+    """Brax actor_step with an explicit terminated-episode hidden reset."""
+    from brax.training import acting
+
+    actions, policy_extras = policy(env_state.obs, key)
+    hidden_out = policy_extras["policy_hidden_out"]
+    nstate = env.step(env_state, actions)
+    keep = 1.0 - nstate.done
+    while keep.ndim < hidden_out.ndim:
+        keep = keep[..., None]
+    hidden_out = hidden_out * keep
+    next_obs = dict(nstate.obs)
+    next_obs[HIDDEN_OBSERVATION_KEY] = hidden_out
+    nstate = nstate.replace(obs=next_obs)
+    state_extras = {name: nstate.info[name] for name in extra_fields}
+    return nstate, acting.Transition(
+        observation=env_state.obs,
+        action=actions,
+        reward=nstate.reward,
+        discount=1 - nstate.done,
+        next_observation=nstate.obs,
+        extras={"policy_extras": policy_extras, "state_extras": state_extras},
+    )
+
+
+def install_recurrent_collector_hooks() -> None:
+    """Install process-local hooks before the single-policy PPO job starts."""
+    from brax.training import acting
+
+    acting.actor_step = recurrent_actor_step
+    ppo_networks.make_inference_fn = make_recurrent_inference_fn
+
+
+def _policy_params(value):
+    policy = getattr(value, "policy", value)
+    params = policy.get("params") if hasattr(policy, "get") else None
+    if params is None:
+        raise ValueError("recurrent policy params missing")
+    return params
+
+
+def export_recurrent_onnx(
+    params,
+    action_size: int,
+    obs_size: int,
+    hidden_size: int,
+    output_path: str | Path,
+) -> dict:
+    import onnx
+    from onnx import TensorProto, helper, numpy_helper
+    import onnxruntime as ort
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    mean = np.asarray(params[0].mean["state"], dtype=np.float32)
+    std = np.asarray(params[0].std["state"], dtype=np.float32)
+    p = _policy_params(params[1])
+    initializers = [
+        numpy_helper.from_array(mean, name="obs_mean"),
+        numpy_helper.from_array(std, name="obs_std"),
+        numpy_helper.from_array(
+            np.asarray(p["obs_projection"]["kernel"], dtype=np.float32),
+            name="obs_weight",
+        ),
+        numpy_helper.from_array(
+            np.asarray(p["hidden_projection"]["kernel"], dtype=np.float32),
+            name="hidden_weight",
+        ),
+        numpy_helper.from_array(
+            np.asarray(p["hidden_bias"], dtype=np.float32), name="hidden_bias"
+        ),
+        numpy_helper.from_array(
+            np.asarray(p["distribution_head"]["kernel"], dtype=np.float32),
+            name="head_weight",
+        ),
+        numpy_helper.from_array(
+            np.asarray(p["distribution_head"]["bias"], dtype=np.float32),
+            name="head_bias",
+        ),
+        numpy_helper.from_array(np.asarray([0], dtype=np.int64), name="slice_starts"),
+        numpy_helper.from_array(
+            np.asarray([action_size], dtype=np.int64), name="slice_ends"
+        ),
+        numpy_helper.from_array(np.asarray([1], dtype=np.int64), name="slice_axes"),
+        numpy_helper.from_array(np.asarray([1], dtype=np.int64), name="slice_steps"),
+    ]
+    nodes = [
+        helper.make_node("Sub", ["obs", "obs_mean"], ["obs_centered"]),
+        helper.make_node("Div", ["obs_centered", "obs_std"], ["obs_normalized"]),
+        helper.make_node("MatMul", ["obs_normalized", "obs_weight"], ["obs_projected"]),
+        helper.make_node("MatMul", ["h_in", "hidden_weight"], ["hidden_projected"]),
+        helper.make_node("Add", ["obs_projected", "hidden_projected"], ["hidden_sum"]),
+        helper.make_node("Add", ["hidden_sum", "hidden_bias"], ["hidden_pre"]),
+        helper.make_node("Tanh", ["hidden_pre"], ["h_out"]),
+        helper.make_node(
+            "Gemm", ["h_out", "head_weight", "head_bias"], ["distribution_logits"]
+        ),
+        helper.make_node(
+            "Slice",
+            ["distribution_logits", "slice_starts", "slice_ends", "slice_axes", "slice_steps"],
+            ["action_location"],
+        ),
+        helper.make_node("Tanh", ["action_location"], ["continuous_actions"]),
+    ]
+    graph = helper.make_graph(
+        nodes,
+        "open_duck_recurrent_final_action",
+        [
+            helper.make_tensor_value_info("obs", TensorProto.FLOAT, [1, obs_size]),
+            helper.make_tensor_value_info("h_in", TensorProto.FLOAT, [1, hidden_size]),
+        ],
+        [
+            helper.make_tensor_value_info(
+                "continuous_actions", TensorProto.FLOAT, [1, action_size]
+            ),
+            helper.make_tensor_value_info("h_out", TensorProto.FLOAT, [1, hidden_size]),
+        ],
+        initializer=initializers,
+    )
+    model = helper.make_model(
+        graph,
+        producer_name="open-duck-playground-ground-up",
+        opset_imports=[helper.make_operatorsetid("", 12)],
+    )
+    model.ir_version = min(model.ir_version, 10)
+    onnx.checker.check_model(model)
+    onnx.save(model, output_path)
+
+    network = make_recurrent_ppo_networks(
+        {
+            "state": (obs_size,),
+            "privileged_state": (obs_size,),
+            HIDDEN_OBSERVATION_KEY: (hidden_size,),
+        },
+        action_size,
+        preprocess_observations_fn=lambda value, stats: (value - stats.mean) / stats.std,
+        value_obs_key="state",
+        recurrent_hidden_size=hidden_size,
+    )
+    session = ort.InferenceSession(str(output_path), providers=["CPUExecutionProvider"])
+    hidden_jax = np.zeros((1, hidden_size), dtype=np.float32)
+    hidden_onnx = hidden_jax.copy()
+    max_action_error = 0.0
+    max_hidden_error = 0.0
+    for step in range(8):
+        obs = np.linspace(-0.25, 0.25, obs_size, dtype=np.float32)[None, :]
+        obs = obs + np.float32(step * 0.001)
+        logits, next_hidden = network.policy_network.apply_with_state(
+            params[0],
+            params[1],
+            {"state": obs, HIDDEN_OBSERVATION_KEY: hidden_jax},
+        )
+        expected_action = np.tanh(np.asarray(logits)[:, :action_size])
+        actual_action, next_hidden_onnx = session.run(
