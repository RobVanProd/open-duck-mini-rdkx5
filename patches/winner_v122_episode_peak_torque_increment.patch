+def ground_up_episode_peak_torque_increment_cost(
+    actuator_force_nm: jax.Array,
+    previous_peak_excess_nm: jax.Array,
+    threshold_nm: float,
+    dt: float,
+    enabled: bool,
+) -> tuple[jax.Array, jax.Array]:
+    """Return a cost rate whose episode integral is global peak excess."""
+    if not enabled:
+        return jp.zeros(()), previous_peak_excess_nm
+    instantaneous_excess = jp.maximum(
+        jp.max(jp.abs(actuator_force_nm)) - threshold_nm,
+        0.0,
+    )
+    peak_excess = jp.maximum(
+        previous_peak_excess_nm,
+        instantaneous_excess,
+    )
+    increment_rate = (peak_excess - previous_peak_excess_nm) / dt
+    return increment_rate, peak_excess
+
+
