 # if set to false, won't require the reference data to be present and won't compute the reference motions polynoms for nothing
 USE_IMITATION_REWARD = True
 USE_MOTOR_SPEED_LIMITS = True
+GROUND_UP_PITCH_CHAIN_INDICES = (2, 3, 4, 11, 12, 13)
+
+
+def ground_up_tracking_tail_exceedance_cost(
+    sent_target: jax.Array,
+    actual_position: jax.Array,
+    threshold_rad: float,
+) -> jax.Array:
+    """Mean squared pitch-chain tracking excess above the frozen gate."""
+    indices = jp.asarray(GROUND_UP_PITCH_CHAIN_INDICES, dtype=jp.int32)
+    error = jp.abs(sent_target[indices] - actual_position[indices])
+    excess = jp.maximum(error - threshold_rad, 0.0)
+    return jp.mean(jp.square(excess))
 
 
