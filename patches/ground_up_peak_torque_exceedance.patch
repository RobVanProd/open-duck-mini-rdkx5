+def ground_up_peak_torque_exceedance_cost(
+    actuator_force_nm: jax.Array,
+    threshold_nm: float,
+) -> jax.Array:
+    """Mean squared all-joint torque excess above the physical peak limit."""
+    excess = jp.maximum(jp.abs(actuator_force_nm) - threshold_nm, 0.0)
+    return jp.mean(jp.square(excess))
+
