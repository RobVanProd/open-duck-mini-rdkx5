+WINNER_V119_RATE_LIMITS_RAD_S = np.asarray(
+    [
+        1.0, 0.75, 1.4736209064722061, 1.4300791546702385,
+        1.3976470567286015, 0.5, 0.5, 0.5, 0.5, 0.5, 0.75,
+        1.25, 1.0, 1.2215287424623966,
+    ],
+    dtype=np.float32,
+)
+WINNER_V119_PITCH_MASK = np.asarray(
+    [
+        False, False, True, True, True, False, False,
+        False, False, False, False, True, True, True,
+    ],
+    dtype=np.bool_,
+)
+WINNER_V119_GUARD_MARGIN_RAD = np.float32(0.165)
+
+
+def winner_v119_transition_match(
+    proposed_target: jax.Array,
+    previous_target: jax.Array,
+    actual_position: jax.Array,
+    velocity_limits_rad_s: jax.Array,
+    dt: float,
+    enabled: bool,
+) -> jax.Array:
+    """Match the deployed G3 then final rate-projection hierarchy."""
+    if not enabled:
+        return proposed_target
+    margin = jp.float32(WINNER_V119_GUARD_MARGIN_RAD)
+    guarded = jp.clip(
+        proposed_target,
+        actual_position - margin,
+        actual_position + margin,
+    )
+    guarded = jp.where(
+        jp.asarray(WINNER_V119_PITCH_MASK), guarded, proposed_target
+    )
+    maximum_step = jp.asarray(velocity_limits_rad_s) * dt
+    return jp.clip(
+        guarded,
+        previous_target - maximum_step,
+        previous_target + maximum_step,
+    )
+
 
