+def reward_signed_command_progress(
+    commands: jax.Array,
+    local_vel: jax.Array,
+    command_deadband: float = 0.01,
+) -> jax.Array:
+    """Gate-aligned signed vx ratio for nonzero forward commands.
+
+    Zero command retains the canonical Gaussian tracking behavior in the caller.
+    """
+    denominator = jp.maximum(jp.abs(commands[0]), command_deadband)
+    ratio = local_vel[0] / denominator
+    return jp.nan_to_num(jp.clip(ratio, -1.0, 1.0))
+
