+# Compiled Open Duck Mini v2 schema: body 1 is the massless outer `base` and
+# body 2 is the inertial `trunk_assembly`.  The runner verifies this by name
+# before enabling the ground-up targeted randomizer.
+TORSO_BODY_ID = 2
+
+
+def make_ground_up_torso_com_x_randomizer(
+    torso_body_id: int,
+    min_offset_m: float,
+    max_offset_m: float,
+    distribution: str = "uniform",
+):
+    """Randomize only the named torso's inertial-frame X COM coordinate."""
+    torso_body_id = int(torso_body_id)
+    min_offset_m = float(min_offset_m)
+    max_offset_m = float(max_offset_m)
+    if torso_body_id <= 0:
+        raise ValueError("torso_body_id must identify a non-world body")
+    if not min_offset_m < max_offset_m:
+        raise ValueError("torso COM X range requires min_offset_m < max_offset_m")
+    if distribution not in {"uniform", "anchors"}:
+        raise ValueError(f"unsupported torso COM distribution: {distribution}")
+
+    def randomizer(model: mjx.Model, rng: jax.Array):
+        @jax.vmap
+        def rand_body_ipos(key):
+            if distribution == "uniform":
+                offset = jax.random.uniform(
+                    key, minval=min_offset_m, maxval=max_offset_m
+                )
+            else:
+                anchors = jp.asarray([min_offset_m, 0.0, max_offset_m])
+                offset = anchors[jax.random.randint(key, (), 0, anchors.shape[0])]
+            return model.body_ipos.at[torso_body_id, 0].set(
+                model.body_ipos[torso_body_id, 0] + offset
+            )
+
+        body_ipos = rand_body_ipos(rng)
+        in_axes = jax.tree_util.tree_map(lambda x: None, model)
+        in_axes = in_axes.tree_replace({"body_ipos": 0})
+        return model.tree_replace({"body_ipos": body_ipos}), in_axes
+
+    return randomizer
